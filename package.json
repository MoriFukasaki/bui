{
  "name": "camroom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --import ./scripts/offline.mjs --test --test-isolation=none",
    "build": "node scripts/build.mjs",
    "check:publish": "node scripts/check-publish.mjs",
    "check:publish:test": "node scripts/prove-publish-check.mjs",
    "prestart": "node scripts/migrate.mjs",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/lib-storage": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6",
    "@neon/realtime": "^0.1.2",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  }
}
