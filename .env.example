DOMAIN=cam.example.com
# Neon CLI writes real secrets to .env.local. Do not put them in browser JS.
NEON_BUCKET=assets
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
RECORDING_DIR=./data/recordings
MAX_RECORDING_BYTES=2147483648
# Optional: coturn with use-auth-secret and a matching static-auth-secret.
# Use a dedicated TURN domain and allow the TURN service/relay ports on its host.
TURN_URLS=
TURN_SECRET=
# Provider-issued credentials: use these instead of TURN_SECRET, never both.
TURN_USERNAME=
TURN_PASSWORD=
# all = direct + relay fallback; relay = require TURN, useful to verify 4G/5G connectivity.
ICE_TRANSPORT_POLICY=all

# Single administrator account. Generate a scrypt hash with npm run admin:password.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
